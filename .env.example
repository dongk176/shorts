# Shared server/worker database. Use the existing ai-talk Supabase direct connection URL.
DATABASE_URL=
NON_PRODUCTION_DATABASE_FINGERPRINT=
# Password-independent SHA-256 identity of the exact production PostgreSQL
# username, host, port, and database. Required by production migrations and
# the production predeploy verifier.
PRODUCTION_DATABASE_FINGERPRINT=

# Supabase Auth. Prefer the publishable key from Project Settings > API Keys.
# SUPABASE_SERVICE_ROLE_KEY remains server-only and is accepted as a fallback.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Firebase Analytics web app. These are public browser configuration values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# YouTube Data API is used by Vercel to validate duration and metadata.
YOUTUBE_API_KEY=

# Vercel Cron authenticates daily YouTube collection and hourly billing renewals.
# Generate with: openssl rand -base64 32
CRON_SECRET=
# Transactional job-completion email. The onboarding choice is skipped unless
# both values are configured. Verify the sender domain in Resend first.
RESEND_API_KEY=
# Example: Easy Cut <notifications@easycut.co.kr>
RESEND_FROM_EMAIL=
# FREE search.list pages per daily collection. 30 pages are up to 1,500 candidates.
FREE_SEARCH_MAX_PAGES=30

# Required by the worker. Every source video is transcribed before highlight selection.
# The same key is used for OpenAI highlight fallback when Gemini is unavailable.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_FALLBACK_MODEL=whisper-1
OPENAI_HIGHLIGHT_FALLBACK_MODEL=gpt-5-nano
OPENAI_COMMENT_FALLBACK_MODEL=gpt-5-nano
OPENAI_TRANSCRIBE_CHUNK_SECONDS=30
OPENAI_TRANSCRIBE_MAX_WORKERS=4

# Candidate-only multilingual transcription. Keep both runtime flags disabled
# until the isolated worker image and admin canary have been verified.
ELEVENLABS_API_KEY=
ELEVENLABS_TRANSCRIBE_MODEL=scribe_v2
ELEVENLABS_TRANSCRIPTION_ENABLED=false
# Completed subtitle templates reuse word-timed transcription, but remain a
# separately admitted admin canary with an independently pinned renderer.
SUBTITLE_TEMPLATES_ENABLED=false
# Local development may use an HTTP loopback receiver. Production uploads are
# admitted only when their immutable v4 render release matches the receiver.
UNIFIED_TEMPLATE_SUBTITLE_LOCAL_UPLOAD_ENABLED=false
FILE_UPLOAD_ENABLED=false
FILE_UPLOAD_RECEIVER_URL=http://127.0.0.1:8090
FILE_UPLOAD_RECEIVER_ALLOWED_HOSTS=127.0.0.1
FILE_UPLOAD_TOKEN_SECRET=
FILE_UPLOAD_CAPACITY_FUNCTION_ARN=
# Exact immutable worker identity used only by the upload service. These are
# server-side, non-secret release values and must match the ECS task image.
FILE_UPLOAD_WORKER_SOURCE_GIT_SHA=
FILE_UPLOAD_WORKER_IMAGE_DIGEST=
FILE_UPLOAD_WORKER_FONT_MANIFEST_SHA256=

# Optional primary provider for selecting highlights from the OpenAI transcript.
# Keep Gemini disabled unless this key belongs to a Cloud project with active
# billing and the paid-service data processing terms have been verified.
GEMINI_API_KEY=
GEMINI_PAID_DATA_PROCESSING_CONFIRMED=false
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_COMMENT_MODEL=gemini-2.5-flash-lite
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Paid-plan and usage-grant enforcement. Keep true in production.
MVP_PLAN_ENFORCEMENT=true
# One-time login grant for members without payment history. Set false to pause.
ONBOARDING_WELCOME_GRANT_ENABLED=true
# The retired 10k thank-you event stays off unless deliberately re-enabled.
SHORTS_10K_EVENT_ENABLED=false

# Legacy Nicepay credentials are used only by the one-time test-subscription cleanup script.
NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=
NICEPAY_API_BASE_URL=https://sandbox-api.nicepay.co.kr
NICEPAY_BILLING_KEY_ENCRYPTION_KEY=

# ThePayOne production billing. Keep disabled until the webhook and Vercel Firewall rule are verified.
THEPAYONE_BILLING_ENABLED=false
THEPAYONE_MID=
THEPAYONE_TERMINAL_ID=
THEPAYONE_PAY_KEY=
# arti02 manual-card terminal for one-time package and add-on payments.
# MID falls back to THEPAYONE_MID when left empty. Both modes default to legacy.
# Keep the pay key in Vercel or an untracked .env.local.
THEPAYONE_PACKAGE_BILLING_ENABLED=false
THEPAYONE_PACKAGE_PAYMENT_MODE=legacy
THEPAYONE_ADDON_PAYMENT_MODE=legacy
THEPAYONE_PACKAGE_MID=
THEPAYONE_PACKAGE_TERMINAL_ID=
THEPAYONE_PACKAGE_PAY_KEY=
THEPAYONE_API_BASE_URL=https://api.thepayone.com
THEPAYONE_WEBHOOK_BASE_URL=
THEPAYONE_WEBHOOK_SECRET=
# Generate with: openssl rand -base64 32
THEPAYONE_CARD_TOKEN_ENCRYPTION_KEY=
REFERRAL_SECURITY_SECRET=
REFERRAL_DATA_ENCRYPTION_KEY=
THEPAYONE_RENEWAL_WEBHOOK_GRACE_HOURS=6

# Local-only ThePayOne zero-won registration and manual recurring-charge test.
# ThePayOne currently has no separate test server; successful /api/pay calls are real approvals.
PAYMENT_TEST_MODE=false
PAYMENT_TESTER_EMAILS=
# Development-only: allow allowlisted localhost users to exercise the real
# package/add-on manual checkout without shared runtime flags or capabilities.
THEPAYONE_LOCAL_MANUAL_CHECKOUT_ENABLED=false

# Toss recurring billing for customers who have never paid through the legacy
# provider. Keep every gate disabled until the production migration, preview
# verification, and gradual cohort rollout are complete.
TOSS_BILLING_ENABLED=false
TOSS_BILLING_CHARGES_ENABLED=false
TOSS_BILLING_RENEWALS_ENABLED=false
TOSS_BILLING_COHORT_ASSIGNMENT_ENABLED=false
# Enterprise managed-account card registration and sequential one-time charges.
# This deployment ceiling is separate from the database runtime kill switch.
TOSS_ENTERPRISE_BILLING_ENABLED=false
NEXT_PUBLIC_TOSS_BILLING_CLIENT_KEY=
TOSS_BILLING_SECRET_KEY=
# Generate with: openssl rand -base64 32
TOSS_BILLING_KEY_ENCRYPTION_KEY=

# Toss one-time payments for administrator-issued enterprise payment links.
# Use the paired order-form/payment-window gck/gsk keys. Keep disabled until
# the database migration and a test-key checkout have both been verified.
TOSS_GENERAL_PAYMENT_ENABLED=false
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# AWS/Vercel control plane
AWS_REGION=ap-northeast-2
AWS_ROLE_ARN=
# Exact numeric identities used only by the protected editor release OIDC
# workflow. They are repository metadata, not tokens or credentials.
GITHUB_REPOSITORY_ID=
GITHUB_REPOSITORY_OWNER_ID=
AWS_BATCH_JOB_QUEUE=
AWS_BATCH_JOB_DEFINITION_SHORT=
AWS_BATCH_JOB_DEFINITION_LONG=
# Logical release IDs are generated from production-project-targets.json. Do
# not hand-edit these in production or derive them from an ARN at runtime.
LEGACY_PROJECT_JOB_DEFINITION_ARN=
LEGACY_PROJECT_BATCH_QUEUE_ARN=
LEGACY_PROJECT_BATCH_TARGET_RELEASE_ID=
# Exact immutable candidate target. Source-range jobs and every retry remain
# pinned to these ARNs while legacy jobs keep the existing production path.
SOURCE_RANGE_SELECTION_ENABLED=false
SOURCE_RANGE_JOB_DEFINITION_ARN=
SOURCE_RANGE_BATCH_QUEUE_ARN=
SOURCE_RANGE_BATCH_TARGET_RELEASE_ID=
# Exact immutable target used only after the server admits a job to the
# ElevenLabs transcription canary. Stable jobs never read these values.
ELEVENLABS_TRANSCRIPTION_JOB_DEFINITION_ARN=
ELEVENLABS_TRANSCRIPTION_BATCH_QUEUE_ARN=
ELEVENLABS_TRANSCRIPTION_BATCH_TARGET_RELEASE_ID=
# Exact immutable target used only by approved subtitle-template jobs. The
# queue may be the isolated ElevenLabs queue, but the Job Definition must be a
# new revision pinned to the caption renderer digest.
SUBTITLE_TEMPLATES_JOB_DEFINITION_ARN=
SUBTITLE_TEMPLATES_BATCH_QUEUE_ARN=
SUBTITLE_TEMPLATES_BATCH_TARGET_RELEASE_ID=
# Exact immutable target for trusted TemplateConfig v5 initial renders. This
# Job Definition must be separate from every stable/candidate definition; the
# queue may be shared with another isolated project target.
UNIFIED_TEMPLATE_SUBTITLES_JOB_DEFINITION_ARN=
UNIFIED_TEMPLATE_SUBTITLES_BATCH_QUEUE_ARN=
UNIFIED_TEMPLATE_SUBTITLES_BATCH_TARGET_RELEASE_ID=
# Optional one-generation trust marker for already-created unified projects
# during an immutable Job Definition rotation. Validated jobs execute on the
# current hardened target. Never use it for new web admissions; remove it after
# no queued/running project references it.
UNIFIED_TEMPLATE_SUBTITLES_PREVIOUS_JOB_DEFINITION_ARN=
AWS_S3_OUTPUT_BUCKET=
# Infrastructure deployments must keep the currently verified legacy rerender
# worker separate from a new candidate image.
WORKER_IMAGE_TAG=
LEGACY_RERENDER_IMAGE_TAG=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_B64=
CLOUDFRONT_PRIVATE_KEY_PATH=

# Local API development without provisioning. Never enable in production.
AWS_BATCH_MOCK=true
VIDEO_JOB_BACKEND=aws_batch
RANGE_EDITING_ENABLED=false
# Local editor experiment. Production always forces this off. AI comment
# regeneration additionally requires the verified paid-Gemini gate above.
EDITOR_OVERLAY_PREVIEW_ENABLED=false
EDITOR_RENDERING_V2_ENABLED=false
EDITOR_RENDERING_V2_GLOBAL_ENABLED=false
EDITOR_RENDERING_V2_TEST_USER_IDS=
# Build-time v4 compiler capability. Runtime access still requires the
# immutable release assignment, rollout bucket, and database kill switch.
NEXT_PUBLIC_EDITOR_RENDER_SPEC_V4_ENABLED=false

# Worker runtime
TEMP_ROOT=/tmp/shorts-maker
YTDLP_TIMEOUT_SECONDS=300
AI_TIMEOUT_SECONDS=120
CLEAN_CLIP_PRESET=superfast
CLEAN_CLIP_CRF=20
EDIT_TIMELINE_CAPTURE_ENABLED=true
MAC_WORKER_ID=
MAC_WORKER_POLL_SECONDS=5

# YouTube catalog rollout. Apply 202609090001 first. All switches default OFF.
# Project must be the actual Google project owning YOUTUBE_API_KEY, not an alias.
YOUTUBE_DISCOVERY_ENABLED=false
YOUTUBE_QUOTA_PROJECT_ID=
YOUTUBE_CATALOG_READS_ENABLED=false
# Enable only after both 202609230001/2 search migrations and candidate verification.
YOUTUBE_POPULAR_SEARCH_ENABLED=false
YOUTUBE_CATALOG_BACKFILL_ENABLED=false
# Separate legacy cleanup lock. Keep OFF through migration and first promotion.
# Enable only after restore verification and the final source/catalog comparison.
YOUTUBE_LEGACY_SNAPSHOT_CLEANUP_ENABLED=false
# Requires matching key fingerprint, verified quotas/shared clients, completed
# backfill comparison and expanded_at in youtube_quota_verifications.
YOUTUBE_DISCOVERY_EXPANDED=false

# Japan discovery: enable only after quota verification and first successful collection.
YOUTUBE_JP_COLLECTION_ENABLED=false
YOUTUBE_JP_DISCOVERY_ENABLED=false

# Server-only Meta reviewer exception; empty keeps publishing administrator-only.
# One explicitly provisioned non-admin user, one owned test short, UTC expiry.
# See docs/reviews/meta-reviewer-access-2026-09-21/README.md before configuring.
# JSON shape: {"userId":"UUID","shortId":"UUID","expiresAt":"ISO-8601 UTC"}
META_REVIEWER_ACCESS=

# New JPY contracts only; retain all existing Paddle price variables for renewals.
PADDLE_PRICE_LITE_JPY_20261021_JPY=
PADDLE_PRICE_CREATOR_3M_JPY_20261021_JPY=
PADDLE_PRICE_CREATOR_6M_JPY_20261021_JPY=
PADDLE_PRICE_CREATOR_12M_JPY_20261021_JPY=
PADDLE_PRICE_PRO_3M_JPY_20261021_JPY=
PADDLE_PRICE_PRO_6M_JPY_20261021_JPY=
PADDLE_PRICE_PRO_12M_JPY_20261021_JPY=
# Administrator-only related short-video search; keys are server-only.
RANKING_SEMANTIC_SEARCH_ENABLED=0
RANKING_EMBEDDING_API_KEY=

# PayPal: server-only values; enable after Live app, plans and webhook are verified.
PAYPAL_ENABLED=false
PAYPAL_ONE_TIME_ENABLED=false
PAYPAL_MERCHANT_ID=
PAYPAL_ENVIRONMENT=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_ORIGIN=https://www.easycut.co.kr
PAYPAL_PLAN_PRO_1M=
PAYPAL_PLAN_STARTER_3M=
PAYPAL_PLAN_STARTER_6M=
PAYPAL_PLAN_STARTER_12M=
PAYPAL_PLAN_EXPERT_3M=
PAYPAL_PLAN_EXPERT_6M=
PAYPAL_PLAN_EXPERT_12M=
