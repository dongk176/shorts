# Optional. Used only when a video has no downloadable subtitles.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Optional. Used to select highlights from timestamped subtitles.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local service settings
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_PORT=3000
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
STORAGE_DIR=/app/storage
DATABASE_PATH=/app/storage/jobs.db
TEMP_ROOT=/tmp/shorts-maker
MAX_CONCURRENT_JOBS=1
YTDLP_TIMEOUT_SECONDS=300
AI_TIMEOUT_SECONDS=120
