# Shared server/worker database. Use the existing ai-talk Supabase direct connection URL.
DATABASE_URL=

# Supabase Auth. Prefer the publishable key from Project Settings > API Keys.
# SUPABASE_SERVICE_ROLE_KEY remains server-only and is accepted as a fallback.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Firebase Analytics web app. These are public browser configuration values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# YouTube Data API is used by Vercel to validate duration and metadata.
YOUTUBE_API_KEY=

# Vercel Cron authenticates daily YouTube collection and hourly billing renewals.
# Generate with: openssl rand -base64 32
CRON_SECRET=
# FREE search.list pages per daily collection. 30 pages are up to 1,500 candidates.
FREE_SEARCH_MAX_PAGES=30

# Required by the worker. Every source video is transcribed before highlight selection.
# The same key is used for OpenAI highlight fallback when Gemini is unavailable.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_HIGHLIGHT_FALLBACK_MODEL=gpt-5-nano
OPENAI_COMMENT_FALLBACK_MODEL=gpt-5-nano
OPENAI_TRANSCRIBE_CHUNK_SECONDS=30
OPENAI_TRANSCRIBE_MAX_WORKERS=4

# Optional primary provider for selecting highlights from the OpenAI transcript.
# Keep Gemini disabled unless this key belongs to a Cloud project with active
# billing and the paid-service data processing terms have been verified.
GEMINI_API_KEY=
GEMINI_PAID_DATA_PROCESSING_CONFIRMED=false
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_COMMENT_MODEL=gemini-2.5-flash-lite
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Paid-plan and usage-grant enforcement. Keep true in production.
MVP_PLAN_ENFORCEMENT=true
# One-time login grant for members without payment history. Set false to pause.
ONBOARDING_WELCOME_GRANT_ENABLED=true

# Legacy Nicepay credentials are used only by the one-time test-subscription cleanup script.
NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=
NICEPAY_API_BASE_URL=https://sandbox-api.nicepay.co.kr
NICEPAY_BILLING_KEY_ENCRYPTION_KEY=

# ThePayOne production billing. Keep disabled until the webhook and Vercel Firewall rule are verified.
THEPAYONE_BILLING_ENABLED=false
THEPAYONE_MID=
THEPAYONE_TERMINAL_ID=
THEPAYONE_PAY_KEY=
# Package-only manual card terminal. MID falls back to THEPAYONE_MID when left empty.
# Keep the pay key in Vercel or an untracked .env.local.
THEPAYONE_PACKAGE_BILLING_ENABLED=false
THEPAYONE_PACKAGE_MID=
THEPAYONE_PACKAGE_TERMINAL_ID=
THEPAYONE_PACKAGE_PAY_KEY=
THEPAYONE_API_BASE_URL=https://api.thepayone.com
THEPAYONE_WEBHOOK_BASE_URL=
THEPAYONE_WEBHOOK_SECRET=
# Generate with: openssl rand -base64 32
THEPAYONE_CARD_TOKEN_ENCRYPTION_KEY=
REFERRAL_SECURITY_SECRET=
REFERRAL_DATA_ENCRYPTION_KEY=
THEPAYONE_RENEWAL_WEBHOOK_GRACE_HOURS=6

# Local-only ThePayOne zero-won registration and manual recurring-charge test.
# ThePayOne currently has no separate test server; successful /api/pay calls are real approvals.
PAYMENT_TEST_MODE=false
PAYMENT_TESTER_EMAILS=

# AWS/Vercel control plane
AWS_REGION=ap-northeast-2
AWS_ROLE_ARN=
AWS_BATCH_JOB_QUEUE=
AWS_BATCH_JOB_DEFINITION_SHORT=
AWS_BATCH_JOB_DEFINITION_LONG=
AWS_S3_OUTPUT_BUCKET=
# Infrastructure deployments must keep the currently verified legacy rerender
# worker separate from a new candidate image.
WORKER_IMAGE_TAG=
LEGACY_RERENDER_IMAGE_TAG=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_B64=
CLOUDFRONT_PRIVATE_KEY_PATH=

# Local API development without provisioning. Never enable in production.
AWS_BATCH_MOCK=true
VIDEO_JOB_BACKEND=aws_batch
RANGE_EDITING_ENABLED=false
# Local editor experiment. Production always forces this off. AI comment
# regeneration additionally requires the verified paid-Gemini gate above.
EDITOR_OVERLAY_PREVIEW_ENABLED=false
EDITOR_RENDERING_V2_ENABLED=false
EDITOR_RENDERING_V2_GLOBAL_ENABLED=false
EDITOR_RENDERING_V2_TEST_USER_IDS=

# Worker runtime
TEMP_ROOT=/tmp/shorts-maker
YTDLP_TIMEOUT_SECONDS=300
AI_TIMEOUT_SECONDS=120
CLEAN_CLIP_PRESET=superfast
CLEAN_CLIP_CRF=20
EDIT_TIMELINE_CAPTURE_ENABLED=true
MAC_WORKER_ID=
MAC_WORKER_POLL_SECONDS=5
