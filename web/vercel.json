{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/toss-checkout-reconciliation",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/job-completion-emails",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/youtube-daily",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/billing-renewals",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/youtube-discovery?lane=trending",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/youtube-discovery?lane=views",
      "schedule": "10 8,20 * * *"
