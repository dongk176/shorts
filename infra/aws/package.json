{
  "name": "shorts-mvp-aws",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "npm run build && cdk synth --quiet -c workerImageTag=local-synth -c legacyRerenderImageTag=legacy-local-synth",
    "deploy": "cdk deploy --all --require-approval never",
    "test": "vitest run"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.205.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "aws-cdk": "^2.1024.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
