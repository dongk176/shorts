{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --prefix web",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/.next",
  "crons": [
    {
      "path": "/api/cron/youtube-daily",
      "schedule": "0 8 * * *"
    }
  ]
}
