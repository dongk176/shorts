# Keep the exact promoted editing runtime, renderers, fonts and tools.
# The source commit identifies this build recipe plus the reviewed ingestion file;
# the predecessor runtime source is 43fd759084b49f1bbc13aff609332b646fb7f534.
FROM 181651591905.dkr.ecr.ap-northeast-2.amazonaws.com/shorts-mvp-editor-releases-production@sha256:b2391bed81ca493e2a99db8c1798aaae2400ce7fc4fd7e7475786a2c5300c4d2 AS render

ARG WORKER_SOURCE_GIT_SHA
RUN python -m pip install --no-cache-dir --upgrade --upgrade-strategy eager 'yt-dlp[default]==2026.11.23' \
    && python -c "from importlib.metadata import version; assert version('yt-dlp') == '2026.11.23'; assert version('yt-dlp-ejs') == '0.8.0'; assert version('bgutil-ytdlp-pot-provider') == '1.3.1'"
COPY shorts_worker/ingestion.py /app/worker/shorts_worker/ingestion.py
RUN python -c "import re; from pathlib import Path; sha='$WORKER_SOURCE_GIT_SHA'; assert re.fullmatch('[0-9a-f]{40}', sha); Path('/app/worker/.worker-source-git-sha').write_text(sha + '\\n')"
